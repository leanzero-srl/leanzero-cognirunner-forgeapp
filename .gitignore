# Empty directories
src/frontend/

# A node_modules SYMLINK is not a directory, so the `node_modules/` rule above (trailing
# slash = directories only) does not match it. That hole was patched for issue-glance
# alone; a worktree that links the main checkout's installs in order to build hits it in
# EVERY app, and `add -A <app>` then commits an absolute developer path as a tracked
# symlink. Close it once, for every home a link gets made in.
static/issue-glance/node_modules
static/*/node_modules
test-harness/node_modules
node_modules

# Tool cache (Playwright MCP session data) — not project source
.playwright-mcp/

# Raw video working files for the demo (large binaries; keep out of git history)
static/submission-material/video-src/
static/submission-material/cognirunner-demo-90s.mp4

# Generated marketing renders (regenerate via the cognirunner-marketing skill)
static/submission-material/_marketing/out/

# Knowledge bake (plan §3.15) — raw corpus and the denylist NEVER ship.
# knowledge/raw/ is a verbatim copy of the owner's sources (client-bearing, unscrubbed).
# knowledge/denylist.local is the list of names we are protecting; committing it would
# leak exactly what it exists to keep out. The .example template IS committed.
#
# Both patterns are written WITHOUT a trailing slash on purpose: a worktree commonly
# reaches the sources by SYMLINKING knowledge/raw at the main checkout, and
# `knowledge/raw/` (with the slash) matches only a real directory — git would have
# offered the symlink for commit, which is the leak this block exists to prevent.
knowledge/raw
knowledge/denylist.local
