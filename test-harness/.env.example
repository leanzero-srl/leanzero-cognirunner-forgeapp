# CogniRunner test-harness configuration.
# Copy to .env and fill in. DO NOT commit .env (it is gitignored).

# --- Jira Cloud (required) ---
JIRA_BASE_URL=https://your-instance.atlassian.net
JIRA_ADMIN_EMAIL=you@example.com
JIRA_API_TOKEN=your_atlassian_api_token_here

# --- Test bed knobs (optional; defaults shown) ---
COGTEST_PROJECT_KEY=COGTEST
COGTEST_ISSUE_COUNT=400
# Disposable listener/job fixtures use a project with create and delete rights.
RULES_TEST_PROJECT_KEY=LZPT
JSM_PROJECT_KEY=JT
# Auto-minted Rules API tokens are revoked in finally. Supplied tokens stay owned by you.
# RULES_API_URL=
# RULES_API_TOKEN=
# RESOLVER_ACCOUNT_ID=

# --- Optional BYOK provider keys (dormant this round; harness is Forge-LLM-only) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENROUTER_API_KEY=
# LMSTUDIO_URL=
