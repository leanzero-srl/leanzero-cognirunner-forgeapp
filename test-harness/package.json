{
  "name": "cognirunner-test-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Real at-scale E2E test & hardening harness for CogniRunner (validators, conditions, post-functions, providers) against a live Jira Cloud instance.",
  "scripts": {
    "setup": "node scripts/setup-testbed.mjs",
    "record-replay": "node scripts/record-replay.mjs",
    "attach": "node scripts/attach-rules.mjs",
    "seed": "node scripts/seed-issues.mjs",
    "run": "node scripts/run-transitions.mjs",
    "discover": "node scripts/discover-rules.mjs",
    "discover-exercise": "node scripts/exercise-discovered.mjs",
    "deep": "node scripts/run-deep.mjs",
    "mega": "node scripts/mega-issues.mjs",
    "creative": "node scripts/creative-lab.mjs",
    "stress": "node scripts/stress-lmstudio.mjs",
    "coverage": "node scripts/coverage-report.mjs",
    "forge-logs": "node scripts/_forge-logs.mjs",
    "bulk": "node scripts/bulk-transitions.mjs",
    "fields-all": "node scripts/setup-fields-all.mjs",
    "field-matrix": "node scripts/field-matrix.mjs",
    "report": "node report/aggregate.mjs",
    "teardown": "node scripts/teardown.mjs",
    "probe": "node scripts/probe.mjs",
    "pw": "playwright test",
    "mass": "node scripts/mass-transitions.mjs",
    "verify-memories": "node scripts/verify-memories.mjs",
    "exotic": "node scripts/exotic-pf.mjs",
    "actions": "node scripts/actions-test.mjs",
    "audit": "node scripts/audit-rules.mjs",
    "throttle": "node scripts/throttle-probe.mjs",
    "agile-setup": "node scripts/agile-setup.mjs",
    "agile": "node scripts/agile-test.mjs",
    "pack": "node scripts/pack-transitions.mjs",
    "seed-bulk": "node scripts/seed-bulk.mjs",
    "test:premade": "node scripts/premade-rules.test.mjs",
    "test:recipes": "node scripts/recipes.test.mjs",
    "test:parity": "node scripts/premade-parity.mjs",
    "test:offline": "node scripts/premade-parity.mjs && node scripts/run-offline.mjs && node scripts/upload-contract.test.mjs",
    "test:cron": "node scripts/cron.test.mjs",
    "test:events": "node scripts/jira-events.test.mjs",
    "test:listeners": "node --import ./lib/register-mocks.mjs scripts/listeners.test.mjs",
    "test:rules-offline": "node scripts/cron.test.mjs && node scripts/jira-events.test.mjs && node --import ./lib/register-mocks.mjs scripts/listeners.test.mjs",
    "test:listeners-e2e": "node scripts/listeners-e2e.mjs",
    "test:jobs-e2e": "node scripts/jobs-e2e.mjs",
    "probe:listeners": "node scripts/listeners-agent-probe.mjs",
    "test:premade-e2e": "node scripts/premade-e2e.mjs",
    "test:contract": "node scripts/upload-contract.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}